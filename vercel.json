{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "memory": 4096,
      "maxDuration": 60,
      "runtime": "nodejs22.x"
    }
  },
  "env": {
    "NODE_ENV": "production",
    "MAX_FILE_SIZE_MB": "25"
  }
}
