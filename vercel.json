{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "public": false,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "MAX_FILE_SIZE_MB": "25"
  }
}       